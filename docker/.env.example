# Copie ce fichier en .env puis remplace les valeurs.
# Genere le mot de passe :        openssl rand -hex 16
# Genere la cle de chiffrement :  openssl rand -hex 32

POSTGRES_USER=n8n
POSTGRES_PASSWORD=REMPLACE_MOI
POSTGRES_DB=n8n

# Sans cette cle, tous les identifiants stockes dans n8n deviennent illisibles.
# Ne la change jamais apres le premier demarrage. Ne la commite jamais.
N8N_ENCRYPTION_KEY=REMPLACE_MOI

GENERIC_TIMEZONE=Africa/Porto-Novo
